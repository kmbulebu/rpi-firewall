[Unit]
Description=WAG-D20 console logging and PON status
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/wag-d20-serial-capture --device {{ wag_d20_serial_device | quote }} --interval {{ wag_d20_status_interval }}{{ '' if wag_d20_auto_recovery else ' --no-auto-recovery' }}
Restart=on-failure
RestartSec=5
RuntimeDirectory=wag-d20
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LogNamespace=wag-d20
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=no

[Install]
WantedBy=multi-user.target
