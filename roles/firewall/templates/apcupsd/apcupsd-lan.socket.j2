[Unit]
Description=apcupsd status on the trusted LAN
# Waiting for the LAN device must not hold up sockets.target.
DefaultDependencies=no
After=sysinit.target
Before=shutdown.target
Conflicts=shutdown.target

[Socket]
ListenStream={{ lan_address }}:3551
BindToDevice={{ lan_iface }}
FreeBind=yes

[Install]
WantedBy=multi-user.target
