[Match]
Name={{ vpn_client_iface }}

[Link]
RequiredForOnline=no
MTUBytes={{ lan_vpn_mtu }}

[Network]
VRF={{ vpn_vrf_iface }}
DefaultRouteOnDevice=yes
ConfigureWithoutCarrier=no
IPv6AcceptRA=no
LinkLocalAddressing=no
Address={{ lan_vpn_wg_address }}
LLMNR=false
MulticastDNS=false
IPv4Forwarding=yes
IPv6Forwarding=yes