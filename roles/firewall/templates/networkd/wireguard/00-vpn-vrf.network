[Match]
Name={{ vpn_vrf_iface }}

[Link]
RequiredForOnline=no
MTUBytes={{ lan_vpn_mtu }}

[Network]
ConfigureWithoutCarrier=yes
LLMNR=false
MulticastDNS=false
IPv4Forwarding=yes
IPv6Forwarding=yes

[Route]
# Help ensure our non VPN traffic is separate
Type=prohibit
Destination={{ lan_cidr }}
Table=200
