[Match]
Name={{ lan_vpn_iface }}

[Link]
RequiredForOnline=no
MTUBytes={{ lan_vpn_mtu }}

[Network]
VRF={{ vpn_vrf_iface }}
ConfigureWithoutCarrier=yes
IPv6AcceptRA=no
LinkLocalAddressing=no
Address={{ lan_vpn_router_ip_address }}
DHCPServer=yes
BindCarrier={{ vpn_client_iface }}
LLDP=false
LLMNR=false
MulticastDNS=false
IPForward=true

[DHCPServer]
EmitDNS=yes
# TODO: Make these configurable
DNS=1.1.1.1
DNS=1.0.0.1
EmitRouter=yes
SendOption=26:uint16:{{ lan_vpn_mtu }}
DefaultLeaseTimeSec={{ lan_vpn_dhcp_lease_seconds }}
MaxLeaseTimeSec={{ lan_vpn_dhcp_lease_seconds }}
